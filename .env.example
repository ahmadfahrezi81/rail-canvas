# Every variable the services read. Set real values as Railway variables.

# api
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=20
# Connects as the app role, never postgres.
DATABASE_URL=
# Browser origins allowed to call the API, comma-separated. "https://*.x.dev" matches subdomains.
CORS_ORIGINS=http://localhost:5173
# Header Railway's edge sets to the client IP (clients cannot forge it). Used by rate limits.
REAL_IP_HEADER=X-Real-IP

# Set by Railway; "development" locally. Don't set by hand.
# RAILWAY_ENVIRONMENT_NAME=

# local only: migrations and db scripts (the Postgres DATABASE_PUBLIC_URL, connects as postgres)
MIGRATE_DATABASE_URL=
# local only: the app role's password, set with make db-app-password
APP_DB_PASSWORD=
