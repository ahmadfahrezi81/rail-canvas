# Every variable the services read. Set real values as Railway variables.

# api
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=20
# Connects as the app role, never postgres.
DATABASE_URL=
# Browser origins allowed to call the API, comma-separated. "https://*.x.dev" matches subdomains.
CORS_ORIGINS=http://localhost:5173
# Header Railway's edge sets to the client IP (clients cannot forge it). Used by rate limits.
REAL_IP_HEADER=X-Real-IP

# Set by Railway; "development" locally. Don't set by hand.
# RAILWAY_ENVIRONMENT_NAME=

# Connects as postgres. On Railway's api service: ${{Postgres.DATABASE_URL}}, read only by the
# pre-deploy command (cli migrate), never by the API. Locally: make migrate-up and db scripts.
MIGRATE_DATABASE_URL=
# The app role's password. Locally set with make db-app-password; on a fresh database (staging) the
# pre-deploy command sets it when app cannot log in yet.
APP_DB_PASSWORD=
# The deployed git commit, reported by /health. Set by Railway; empty locally.
# RAILWAY_GIT_COMMIT_SHA=

# Staging only (Step 16): the seeded owner's password (staging-owner@example.com). With it set, the
# pre-deploy command seeds an empty database; never in production. Also local, for the staging
# tests, and the GitHub secret STAGING_OWNER_PASSWORD.
SEED_OWNER_PASSWORD=
# The staging tests (go test -tags staging ./stagingtest/): staging's API, and the owner's password.
# STAGING_URL=
# STAGING_OWNER_PASSWORD=

# Template bucket (Step 8). On Railway: references to the templates bucket, set in .railway/railway.ts.
# Optional: unset, the API runs and the template endpoints answer 503.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
# Redis (Step 11): board cache, cooldown check, rate limits, WebSocket tickets. On Railway a
# reference to the Redis service's private URL. Optional: unset, everything runs on Postgres and
# memory as before. Tests: TEST_REDIS_URL=redis://localhost:6379 runs the Redis tests.
REDIS_URL=
# RAILWAY_REPLICA_ID is set by Railway for each API copy (the log field `replica`); a random id locally.
# Shared secret for POST /webhooks/bot/…, sent as X-Webhook-Secret by the bot Function (Step 15).
# At least 32 characters: openssl rand -hex 32. Unset: the webhook answers 503.
WEBHOOK_SECRET=

# bot: the Telegram bot, a Railway Function (Step 15, functions/webhook/index.ts). Its WEBHOOK_SECRET
# is a reference to the api's. API_URL is the api's private address, set in .railway/railway.ts.
# API_URL=http://rail-canvas.railway.internal:8080
# Telegram sends this back in X-Telegram-Bot-Api-Secret-Token on every update: openssl rand -hex 32.
# Locally too, only so the live test can send fake updates; never printed.
TELEGRAM_SECRET_TOKEN=

# backup: the nightly cron service (Step 9, ops/backup). On Railway only; never set locally.
# Connects as postgres (a dump as app would be filtered by RLS). Reference to Postgres in .railway/railway.ts.
# DATABASE_URL=
# Cloudflare R2 bucket for the dumps, and a key limited to that one bucket (Object Read & Write).
R2_ACCOUNT_ID=
R2_BUCKET=rail-canvas-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The healthchecks.io check's ping URL. A secret: anyone holding it can report a fake success.
HC_PING_URL=
# The cleanup cron service has its own check and its own HC_PING_URL (Step 13).
# restore.sh only: an empty database to restore into, connected as a superuser.
TARGET_URL=
