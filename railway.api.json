{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "api/**",
      "Dockerfile",
      "railway.api.json"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "/app/cli migrate"
    ],
    "startCommand": "/app/api",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
